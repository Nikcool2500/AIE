# ---------------------------------------------------------
# Общие правила игнорирования для репозитория студента
# ---------------------------------------------------------

# Системные файлы ОС
.DS_Store
Thumbs.db

# Конфигурации IDE/редакторов
.vscode/
.idea/
*.swp
*.swo

# Виртуальные окружения Python
.venv/
venv/
env/
ENV/
.conda/
.venv*/

# Кеши Python и скомпилированные файлы
__pycache__/
*.py[cod]
*$py.class

# Папки и файлы сборки/дистрибуции (если вдруг появятся)
build/
dist/
eggs/
*.egg-info/
.installed.cfg

# Кеши и артефакты тестов
.pytest_cache/
.coverage
.coverage.*
htmlcov/

# Журналы
*.log
logs/

# Кеши Jupyter Notebook
.ipynb_checkpoints

# Файлы окружения и конфигурации с потенциальными секретами
.env
*.env
.env.*
!.env.example

# Разное
*.tmp
*.bak
*.old

*template*

data_CIFAR10*/
catboost_info/

project/mlflow.db
project/notebooks/mlruns/
*_mlflow/
!CB_mlflow/

project/artifacts/*
!project/artifacts/model_catboost_best_optuna.pkl
!project/artifacts/scaler_cb.pkl

!project/artifacts/catboost/
